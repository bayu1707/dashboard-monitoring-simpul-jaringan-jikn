{
  "name": "dashboard-simpul-jikn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "import:casefile": "python3 scripts/import-casefile.py",
    "import:landing-pages": "tsx scripts/import-landing-pages.ts",
    "build:references": "tsx scripts/build-national-references.ts",
    "build:pilot": "tsx scripts/build-local-pilot.ts",
    "prepare:java": "tsx scripts/prepare-java-locations.ts",
    "test:import": "python3 -m unittest discover -s tests -p 'test_import_*.py'",
    "validate:shared": "tsx scripts/validate-shared-data.ts",
    "export:shared": "python3 scripts/export-collaboration.py"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-router-dom": "7.18.4",
    "leaflet": "1.9.4",
    "react-leaflet": "5.0.0",
    "leaflet.markercluster": "1.5.3",
    "recharts": "3.10.1",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "vitest": "5.0.4",
    "jsdom": "^27.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.20.6"
  }
}
