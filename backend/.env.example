APP_NAME="Dashboard JIKN API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
# Kosong memakai ../public relatif terhadap backend; absolute path juga didukung.
DASHBOARD_DATA_ROOT=
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
