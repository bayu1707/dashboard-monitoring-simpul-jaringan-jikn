# Semua VITE_* terlihat publik. Jangan simpan token atau rahasia di sini.
# 1 = baca .local/casefile/snapshot.json di server dev; build tetap memakai data publik.
VITE_LOCAL_CASEFILE=0
VITE_LOCAL_PILOT=0
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
